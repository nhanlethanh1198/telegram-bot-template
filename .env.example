# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Environment (development, production)
NODE_ENV=development

# Optional: Logging level (error, warn, info, debug)
LOG_LEVEL=info

# Optional: Bot admin user IDs (comma-separated)
# ADMIN_USER_IDS=123456789,987654321

# Optional: Database URL (if you implement persistence)
# DATABASE_URL=sqlite://bot.db

# Optional: Redis URL (for caching and sessions)
# REDIS_URL=redis://localhost:6379

# Optional: Webhook settings (for production)
# WEBHOOK_URL=https://your-domain.com/webhook
# WEBHOOK_SECRET=your_webhook_secret

# Optional: Rate limiting
# RATE_LIMIT_WINDOW=60000
# RATE_LIMIT_MAX_REQUESTS=30
